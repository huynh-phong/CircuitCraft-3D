# CircuitCraft 3D - environment variables. Placeholders only: never commit real values.
# [Vercel] = set in Vercel Dashboard > Settings > Environment Variables (Preview and Production).
# Full list and order of setup: docs/DEPLOYMENT.md

# --- Supabase ---
# [Vercel] Sent to the browser: project URL and the ANON key only. Changing them requires a new build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# [Vercel] Server only - never expose to the browser, never put it in a VITE_* variable.
# Also used for media storage (private buckets course-media, course-video) and shared OTP / rate limits.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Where the server keeps its data ---
# Empty: data/*.json on this machine (local development). On Vercel, Supabase is always used.
# supabase: use Supabase locally too. Point it at a test project, never at production by accident.
PERSISTENCE_BACKEND=
# [Vercel, optional] Region of the API function. Choose the one closest to the Supabase project. Default: sin1.
VERCEL_FUNCTION_REGION=

# --- AI ---
# [Vercel] Without it the assistants answer locally and say so.
GEMINI_API_KEY=

# [Vercel] Administrator e-mail
ADMIN_EMAIL=

# --- OTP e-mail ---
# [Vercel] Brevo sends over HTTPS and works on Vercel. SMTP ports are often blocked on serverless platforms.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Local / self-hosted alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CircuitCraft 3D <no-reply@circuitcraft3d.com>"

# --- Security (required in production) ---
# [Vercel] Required.
# HMAC secret for session tokens, at least 32 random characters, e.g. `openssl rand -base64 48`.
# Without it production uses an ephemeral secret and every restart logs all users out.
SESSION_SECRET=

# --- Reverse proxy ---
# Number of proxies in front of the server, or a list of trusted proxy IPs/CIDRs, or false.
# Unset: 1 on Render / Vercel, otherwise no proxy is trusted. "true" is refused. See docs/DEPLOYMENT.md.
TRUST_PROXY=

# --- Payments ---
# [Vercel] Set PAYMENT_MODE=mock to keep the simulated checkout online (no real money moves).
# real : orders are confirmed only by a trusted source (today: an admin marks them paid).
# mock : simulated VietQR checkout for development / isolated demo. No money is transferred,
#        orders are flagged isMock and never counted as real revenue.
# Unset: development -> mock, production (NODE_ENV=production, which includes Vercel) -> real.
PAYMENT_MODE=
# Account and VietQR shown in the checkout (also in mock / demo mode, where a button confirms instantly).
# In real mode, checkout is refused while PAYMENT_ACCOUNT_NUMBER is empty.
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ID=
PAYMENT_ACCOUNT_NUMBER=
# Alternative switch for mock mode (ignored when PAYMENT_MODE=real)
ENABLE_MOCK_PAYMENT=

# --- Rate limiting ---
# No settings: limits are built in and shared through Supabase on Vercel (memory when running locally).

# --- Development only ---
# Shows OTP e-mails/SMS in a local inbox simulator (/api/auth/email-preview/:email).
# Ignored when NODE_ENV=production. Never enable on an internet-facing server.
ENABLE_DEV_OTP_PREVIEW=
